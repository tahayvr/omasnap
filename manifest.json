{
  "schemaVersion": 1,
  "id": "tahayvr.postcard",
  "name": "Postcard",
  "version": "2.1.0",
  "author": "tahayvr",
  "license": "MIT",
  "description": "Turn a screenshot or a piece of code into something worth posting: padding, backgrounds, rounded corners, shadows, syntax highlighting, annotations and one-click redaction.",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "entryPoints": {
    "overlay": "Overlay.qml",
    "barWidget": "BarWidget.qml"
  },
  "keepLoaded": true,
  "barWidget": {
    "displayName": "Postcard",
    "category": "Capture",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "icon": "󰆟"
    },
    "schema": [
      {
        "key": "icon",
        "type": "string",
        "label": "Bar icon"
      }
    ],
    "description": "Make a screenshot worth posting."
  }
}
