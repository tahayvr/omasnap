#!/usr/bin/env bash
# postcard-deliver copy <png> ""     <format> <quality> [w h] -> image onto the clipboard
# postcard-deliver save <png> <dest> <format> <quality> [w h [copy]] -> final file on disk,
#                                                        and on the clipboard unless copy is 0
# postcard-deliver file <png> <dest> <format> <quality> [w h] -> the file alone, to be dragged
# postcard-deliver text                                        -> stdin onto the clipboard
# The grab is padded up to whole device pixels so nothing gets resampled;
# w h is the size of the picture inside it, and the surplus is cropped off.
set -uo pipefail

action="${1:-copy}"

if [ "$action" = "text" ]; then
  wl-copy
  exit 0
fi

src="${2:-}"
dest="${3:-}"
format="${4:-png}"
quality="${5:-92}"
width="${6:-}"
height="${7:-}"
alsoCopy="${8:-1}"
[ -f "$src" ] || { echo "Nothing to write"; exit 1; }

mime="image/png"
[ "$format" = "jpg" ] && mime="image/jpeg"

crop=()
[ -n "$width" ] && [ -n "$height" ] && crop=(-crop "${width}x${height}+0+0" +repage)

encode() { # encode <in> <out>
  case "$format" in
    jpg) magick "$1" "${crop[@]}" -background white -flatten -quality "$quality" "$2" ;;
    # WebP keeps transparency; at full quality it is lossless.
    webp)
      if [ "$quality" -ge 100 ]; then
        magick "$1" "${crop[@]}" -define webp:lossless=true "$2"
      else
        magick "$1" "${crop[@]}" -quality "$quality" "$2"
      fi ;;
    *) magick "$1" "${crop[@]}" "$2" ;;
  esac
}

# Browsers and chat apps will not paste image/webp, so a WebP export puts a
# PNG of the render on the clipboard rather than the file.
clip() { # clip <encoded file>
  if [ "$format" = "webp" ]; then
    magick "$src" "${crop[@]}" png:- | wl-copy --type image/png
  else
    wl-copy --type "$mime" < "$1"
  fi
}

case "$action" in
  file)
    # Only the newest is ever being dragged; the app it was dropped on has
    # read the one before by now.
    mkdir -p "$(dirname "$dest")"
    find "$(dirname "$dest")" -maxdepth 1 -type f -name 'postcard-*' -delete
    encode "$src" "$dest"
    printf '%s\n' "$dest"
    ;;
  copy)
    tmp="${src%.png}.out.${format}"
    encode "$src" "$tmp"
    clip "$tmp"
    rm -f "$tmp"
    echo "Copied to the clipboard"
    ;;
  save)
    [ -n "$dest" ] || { echo "No destination"; exit 1; }
    mkdir -p "$(dirname "$dest")"
    encode "$src" "$dest"
    [ "$alsoCopy" = "0" ] || clip "$dest"
    # Best effort: the file is already written, so a notification outage must
    # not report the save as failed.
    omarchy-notification-send "Saved $(basename "$dest")" --image "$dest" >/dev/null 2>&1 || true
    echo "Saved $(basename "$dest")"
    ;;
esac
exit 0
