#!/usr/bin/env bash
# Print the selected text (the primary selection), or the clipboard if
# nothing is selected. Exit 1 when both are empty.
set -u
command -v wl-paste >/dev/null 2>&1 || exit 1
text="$(wl-paste --primary --no-newline 2>/dev/null)"
[ -n "$text" ] || text="$(wl-paste --no-newline 2>/dev/null)"
[ -n "$text" ] || exit 1
printf '%s' "$text"
