#!/usr/bin/env bash
# snap-highlight [lang] [bat-theme] [numbers 0|1]  (code on stdin)
# Prints ANSI-colored code.
set -u
lang="${1:-}"
theme="${2:-ansi}"
numbers="${3:-0}"
[ "$lang" = "auto" ] || [ "$lang" = "txt" ] && lang=""
style=plain; [ "$numbers" = "1" ] && style=numbers

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"

run() { # run [-l lang]
  COLORTERM=truecolor bat --color=always --paging=never --wrap=never \
    --italic-text=always --terminal-width=4000 --style="$style" \
    "$@" --theme="$theme" "$tmp" 2>/dev/null
}

out="$(run ${lang:+-l "$lang"})" && { printf '%s\n' "$out"; exit 0; }
# Unknown language: let bat pick, and fall back to the raw text rather than
# dropping the user's code on the floor.
out="$(run)" && { printf '%s\n' "$out"; exit 0; }
cat "$tmp"
