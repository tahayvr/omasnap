#!/usr/bin/env bash
# postcard-crop <src> <x> <y> <w> <h> <dest> -> the cropped picture at <dest>.
# The editor keeps the file it started from, so a crop is always taken from
# the original rather than from the last crop of a crop.
set -uo pipefail
exec </dev/null
src="${1:-}"; x="${2:-0}"; y="${3:-0}"; w="${4:-0}"; h="${5:-0}"; dest="${6:-}"
[ -f "$src" ] || { echo "Nothing to crop"; exit 1; }
[ -n "$dest" ] || { echo "No destination"; exit 1; }
magick "$src" -crop "${w}x${h}+${x}+${y}" +repage "$dest" || { echo "Could not crop"; exit 1; }
echo "ok"
