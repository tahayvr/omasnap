#!/usr/bin/env bash
# Print a chosen image path, or nothing when cancelled.
# The system picker comes from the XDG desktop portal, so it is whatever
# file chooser the system has configured; zenity and a menu fall back when
# the portal is unavailable.
set -uo pipefail
dir="${1:-$HOME/Pictures}"
here="$(dirname "$0")"

if [ -x /usr/bin/python3 ] && /usr/bin/python3 -c 'import gi' >/dev/null 2>&1 \
   && busctl --user --no-pager list 2>/dev/null | grep -q 'org.freedesktop.portal.Desktop'; then
  /usr/bin/python3 "$here/snap-portal.py" "$dir" 2>/dev/null
  exit 0
fi

if command -v zenity >/dev/null 2>&1; then
  zenity --file-selection --title="Open an image" --filename="$dir/" \
         --file-filter='Images | *.png *.jpg *.jpeg *.webp' 2>/dev/null
  exit 0
fi

list="$(find "$dir" -maxdepth 2 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 200 | cut -d' ' -f2-)"
[ -n "$list" ] || exit 0

if command -v fuzzel >/dev/null 2>&1; then
  printf '%s\n' "$list" | fuzzel --dmenu --prompt='image> ' 2>/dev/null
elif command -v walker >/dev/null 2>&1; then
  printf '%s\n' "$list" | walker --dmenu 2>/dev/null
else
  printf '%s\n' "$list" | head -n1
fi
exit 0
