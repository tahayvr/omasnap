#!/usr/bin/env bash
# Print a chosen image path, or nothing when cancelled. The picker comes from
# the XDG desktop portal, so it is whatever file chooser the system has
# configured.
set -uo pipefail
exec </dev/null
dir="${1:-$HOME/Pictures}"
exec /usr/bin/python3 "$(dirname "$0")/snap-portal.py" "$dir" 2>/dev/null
