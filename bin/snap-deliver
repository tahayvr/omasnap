#!/usr/bin/env bash
# snap-deliver copy <png> ""     <format> <quality>  -> image onto the clipboard
# snap-deliver save <png> <dest> <format> <quality>  -> final file on disk (+ clipboard)
# snap-deliver text                                  -> stdin onto the clipboard
set -uo pipefail

action="${1:-copy}"

if [ "$action" = "text" ]; then
  wl-copy
  exit 0
fi

src="${2:-}"
dest="${3:-}"
format="${4:-png}"
quality="${5:-92}"
[ -f "$src" ] || { echo "Nothing to write"; exit 1; }

mime="image/png"
[ "$format" = "jpg" ] && mime="image/jpeg"

encode() { # encode <in> <out>
  if [ "$format" = "jpg" ]; then
    magick "$1" -background white -flatten -quality "$quality" "$2"
  else
    cp -f "$1" "$2"
  fi
}

case "$action" in
  copy)
    tmp="${src%.png}.out.${format}"
    encode "$src" "$tmp"
    wl-copy --type "$mime" < "$tmp"
    rm -f "$tmp"
    echo "Copied to the clipboard"
    ;;
  save)
    [ -n "$dest" ] || { echo "No destination"; exit 1; }
    mkdir -p "$(dirname "$dest")"
    encode "$src" "$dest"
    wl-copy --type "$mime" < "$dest"
    # Best effort: the file is already written, so a notification outage must
    # not report the save as failed.
    omarchy-notification-send "Saved $(basename "$dest")" --image "$dest" >/dev/null 2>&1 || true
    echo "Saved $(basename "$dest")"
    ;;
esac
exit 0
