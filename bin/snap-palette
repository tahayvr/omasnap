#!/usr/bin/env bash
# Print up to 5 of an image's dominant colors, most dominant first, one
# "#backdrop #source" pair per line. The first is pushed into a comfortable
# lightness band so a screenshot full of white does not produce a blinding
# background; the second is the color as it appears in the image, which the
# title bar tints itself with.
set -uo pipefail
exec </dev/null

img="${1:-}"
[ -f "$img" ] || exit 0

magick "$img" -resize 400x400\> -colors 8 -depth 8 -format %c histogram:info:- 2>/dev/null \
| sort -rn \
| grep -oE '#[0-9A-Fa-f]{6}' \
| head -n 5 \
| awk '
function nib(c) { return index("0123456789abcdef", tolower(c)) - 1 }
function byte(s, i) { return nib(substr(s, i, 1)) * 16 + nib(substr(s, i + 1, 1)) }
{
  hex = substr($0, 2)
  r = byte(hex, 1)
  g = byte(hex, 3)
  b = byte(hex, 5)
  lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
  if (lum > 140) { k = 0.28; o = 178 }   # light source -> soft light backdrop
  else           { k = 0.52; o = 16  }   # dark source  -> deep muted backdrop
  br = int(r * k + o); bg = int(g * k + o); bb = int(b * k + o)
  if (br > 255) br = 255; if (bg > 255) bg = 255; if (bb > 255) bb = 255
  printf "#%02x%02x%02x #%02x%02x%02x\n", br, bg, bb, r, g, b
}'
exit 0
