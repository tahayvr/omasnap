#!/usr/bin/env bash
# Print the dominant color along an image's outer edge as #rrggbb.
# An inset extends this color outwards, so it is sampled from the border
# rather than the whole image: the most common color overall often belongs
# to a content area that never touches the edge, and using it would leave a
# visible seam where the real edge meets the extension.
set -uo pipefail
exec </dev/null

img="${1:-}"
[ -f "$img" ] || exit 0

# Squashed to a fixed size so the four strips append into one image whatever
# the source aspect; only color matters here, not shape.
magick "$img" -resize 200x200! -depth 8 \
  \( -clone 0 -gravity North -crop 200x5+0+0 +repage \) \
  \( -clone 0 -gravity South -crop 200x5+0+0 +repage \) \
  \( -clone 0 -gravity West  -crop 5x200+0+0 +repage -rotate 90 \) \
  \( -clone 0 -gravity East  -crop 5x200+0+0 +repage -rotate 90 \) \
  -delete 0 -append -colors 6 -format %c histogram:info:- 2>/dev/null \
| sort -rn \
| grep -oE '#[0-9A-Fa-f]{6}' \
| head -n 1
exit 0
